      "topic": "Defense in Depth",
      "difficulty": "easy",
      "question": "Which TWO are examples of defense-in-depth controls?",
      "options": [
        {
          "id": "A",
          "text": "Network segmentation"
        },
        {
          "id": "B",
          "text": "Multifactor authentication"
        },
        {
          "id": "C",
          "text": "Sharing administrator passwords"
        },
        {
          "id": "D",
          "text": "Disabling all monitoring"
        }
      ],
      "correct_answers": [
        "A",
        "B"
      ],
      "explanation": "Network segmentation and MFA reduce different attack paths and provide complementary protections.",
      "tags": [
        "security-controls"
