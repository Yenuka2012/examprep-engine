    {
      "id": "DEMO-Q001",
      "type": "single_choice",
      "domain": "Governance",
      "topic": "Risk",
      "difficulty": "easy",
      "question": "What is the main purpose of a risk assessment?",
      "options": [
        {
          "id": "A",
          "text": "To purchase security products"
        },
        {
          "id": "B",
          "text": "To identify and evaluate risks"
        },
        {
          "id": "C",
          "text": "To guarantee there will be no incidents"
        },
        {
          "id": "D",
          "text": "To replace management decisions"
        }
      ],
      "correct_answers": [
        "B"
      ],
      "explanation": "Risk assessment identifies and evaluates relevant risks so that appropriate treatment decisions can be made.",
      "tags": [
        "risk"
      ]
    },
    {
      "id": "DEMO-Q002",
      "type": "single_choice",
      "domain": "Operations",
      "topic": "Incident Response",
      "difficulty": "medium",
      "question": "Which step should follow identification and initial analysis of a suspected security incident?",
      "options": [
        {
          "id": "A",
          "text": "Delete all logs immediately"
        },
        {
          "id": "B",
          "text": "Ignore the alert"
        },
        {
          "id": "C",
          "text": "Follow the incident response process and contain as appropriate"
        },
        {
          "id": "D",
          "text": "Publish credentials"
        }
      ],
      "correct_answers": [
        "C"
      ],
      "explanation": "Incidents should be managed using the approved response process, with containment proportional to the assessed incident.",
      "tags": [
        "incident-response"
      ]
    },
    {
