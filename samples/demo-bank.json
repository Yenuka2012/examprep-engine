      "topic": "Ownership",
      "difficulty": "medium",
      "question": "Who should accept residual business risk after security recommendations?",
      "options": [
        {
          "id": "A",
          "text": "An authorized business risk owner"
        },
        {
          "id": "B",
          "text": "Any external vendor"
        },
        {
          "id": "C",
          "text": "The newest employee"
        },
        {
          "id": "D",
          "text": "The helpdesk by default"
        }
