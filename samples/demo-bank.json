    {
      "id": "DEMO-Q005",
      "type": "single_choice",
      "domain": "Engineering",
      "topic": "Logging",
      "difficulty": "medium",
      "question": "Which event indicates a potential collection outage?",
      "options": [
        {
          "id": "A",
          "text": "A monitoring dashboard displays normal status"
        },
        {
          "id": "B",
          "text": "A critical source stops sending expected events"
        },
        {
          "id": "C",
          "text": "A user successfully signs in"
        },
        {
          "id": "D",
          "text": "A scheduled report is generated"
        }
      ],
      "correct_answers": [
        "B"
      ],
      "explanation": "Unexpected silence from an expected source can indicate collection failure and should be investigated."
