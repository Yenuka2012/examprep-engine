{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bank_id",
    "title",
    "certification",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "bank_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "certification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "syllabus_version": {
      "type": "string",
      "maxLength": 80
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "domain",
          "question",
          "options",
          "correct_answers",
          "explanation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "type": {
            "enum": [
              "single_choice",
              "multiple_choice"
            ]
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "topic": {
            "type": "string",
            "maxLength": 160
          },
          "difficulty": {
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,15}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 5000
                }
              }
            }
          },
          "correct_answers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "tags": {
            "type": "array",
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          }
        }
      }
    }
  }
}
